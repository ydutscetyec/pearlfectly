# Copy this file to `.env.local` for local development.
# Add the same values in Vercel Project Settings > Environment Variables.
# Do NOT commit your real `.env.local` file.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Supabase database and storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Only these accounts become admins when created.
# Example: ADMIN_EMAILS=owner@example.com,second-admin@example.com
ADMIN_EMAILS=owner@example.com

# OAuth providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
